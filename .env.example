POSTGRES_SUPERUSER_PASSWORD=change-this-local-password
MBACS_DB_PASSWORD=change-this-mbacs-password
N8N_DB_PASSWORD=change-this-n8n-password
MBACS_PROXY_TOKEN=replace-with-at-least-32-random-characters
MBACS_OWNER_KEY=local-owner
MBACS_BASIC_AUTH_USER=mbacs
# Simpan hash bcrypt dengan single quote agar karakter $ tetap literal.
MBACS_BASIC_AUTH_HASH='replace-with-caddy-bcrypt-hash'
MBACS_POSTGRES_PORT=5432
MBACS_POSTGRES_BIND=127.0.0.1
MBACS_HTTP_PORT=8080
MBACS_HTTPS_PORT=8443
MBACS_DOMAIN=http://localhost
N8N_DOMAIN=http://n8n.localhost
N8N_HOST=n8n.localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://n8n.localhost:8080
N8N_SECURE_COOKIE=false
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=Asia/Jakarta
